// Include inside a module. One slot per supported static CC (filter power/type share one).
localparam STATIC_CC_COUNT=74;
function [7:0] static_cc_id;
 input [6:0] slot;
 begin case(slot)
  7'd0: static_cc_id=`PARAM_ID_MASTER_VOL;
  7'd1: static_cc_id=`PARAM_ID_FLT_PAN;
  7'd2: static_cc_id=`PARAM_ID_OSCA_POWER;
  7'd3: static_cc_id=`PARAM_ID_OSCA_WAVE;
  7'd4: static_cc_id=`PARAM_ID_OSCA_UNISON;
  7'd5: static_cc_id=`PARAM_ID_OSCA_DETUNE;
  7'd6: static_cc_id=`PARAM_ID_OSCA_PHASE;
  7'd7: static_cc_id=`PARAM_ID_OSCA_RAND;
  7'd8: static_cc_id=`PARAM_ID_OSCA_WT_POS;
  7'd9: static_cc_id=`PARAM_ID_OSCA_WARP;
  7'd10: static_cc_id=`PARAM_ID_OSCA_PAN;
  7'd11: static_cc_id=`PARAM_ID_OSCA_VOL;
  7'd12: static_cc_id=`PARAM_ID_OSCB_POWER;
  7'd13: static_cc_id=`PARAM_ID_OSCB_WAVE;
  7'd14: static_cc_id=`PARAM_ID_OSCB_UNISON;
  7'd15: static_cc_id=`PARAM_ID_OSCB_DETUNE;
  7'd16: static_cc_id=`PARAM_ID_OSCB_PHASE;
  7'd17: static_cc_id=`PARAM_ID_OSCB_RAND;
  7'd18: static_cc_id=`PARAM_ID_OSCB_WT_POS;
  7'd19: static_cc_id=`PARAM_ID_OSCB_WARP;
  7'd20: static_cc_id=`PARAM_ID_OSCB_PAN;
  7'd21: static_cc_id=`PARAM_ID_OSCB_VOL;
  7'd22: static_cc_id=`PARAM_ID_FLT_TYPE;
  7'd23: static_cc_id=`PARAM_ID_FLT_CUTOFF;
  7'd24: static_cc_id=`PARAM_ID_FLT_RES;
  7'd25: static_cc_id=`PARAM_ID_FLT_MIX;
  7'd26: static_cc_id=`PARAM_ID_ENV1_ATTACK;
  7'd27: static_cc_id=`PARAM_ID_ENV1_DECAY;
  7'd28: static_cc_id=`PARAM_ID_ENV1_SUSTAIN;
  7'd29: static_cc_id=`PARAM_ID_ENV1_RELEASE;
  7'd30: static_cc_id=`PARAM_ID_ENV2_ATTACK;
  7'd31: static_cc_id=`PARAM_ID_ENV2_DECAY;
  7'd32: static_cc_id=`PARAM_ID_ENV2_SUSTAIN;
  7'd33: static_cc_id=`PARAM_ID_ENV2_RELEASE;
  7'd34: static_cc_id=`PARAM_ID_DELAY_FEEDBACK;
  7'd35: static_cc_id=`PARAM_ID_DELAY_TIME;
  7'd36: static_cc_id=`PARAM_ID_DELAY_MIX;
  7'd37: static_cc_id=`PARAM_ID_REVERB_SIZE;
  7'd38: static_cc_id=`PARAM_ID_REVERB_DECAY;
  7'd39: static_cc_id=`PARAM_ID_REVERB_MIX;
  7'd40: static_cc_id=`PARAM_ID_OSCA_WARP_MODE;
  7'd41: static_cc_id=`PARAM_ID_OSCB_WARP_MODE;
  7'd42: static_cc_id=`PARAM_ID_OSCA_WT_INDEX;
  7'd43: static_cc_id=`PARAM_ID_OSCB_WT_INDEX;
  7'd44: static_cc_id=`PARAM_ID_EFFECT_MODE;
  7'd45: static_cc_id=`PARAM_ID_DIST_ENABLE;
  7'd46: static_cc_id=`PARAM_ID_DIST_TYPE;
  7'd47: static_cc_id=`PARAM_ID_DIST_DRIVE;
  7'd48: static_cc_id=`PARAM_ID_DIST_TONE;
  7'd49: static_cc_id=`PARAM_ID_DIST_MIX;
  7'd50: static_cc_id=`PARAM_ID_CHORUS_ENABLE;
  7'd51: static_cc_id=`PARAM_ID_CHORUS_RATE;
  7'd52: static_cc_id=`PARAM_ID_CHORUS_DEPTH;
  7'd53: static_cc_id=`PARAM_ID_CHORUS_DELAY;
  7'd54: static_cc_id=`PARAM_ID_CHORUS_FEEDBACK;
  7'd55: static_cc_id=`PARAM_ID_CHORUS_MIX;
  7'd56: static_cc_id=`PARAM_ID_PHASER_ENABLE;
  7'd57: static_cc_id=`PARAM_ID_PHASER_RATE;
  7'd58: static_cc_id=`PARAM_ID_PHASER_DEPTH;
  7'd59: static_cc_id=`PARAM_ID_PHASER_CENTER;
  7'd60: static_cc_id=`PARAM_ID_PHASER_FEEDBACK;
  7'd61: static_cc_id=`PARAM_ID_PHASER_MIX;
  7'd62: static_cc_id=`PARAM_ID_COMP_ENABLE;
  7'd63: static_cc_id=`PARAM_ID_COMP_THRESH;
  7'd64: static_cc_id=`PARAM_ID_COMP_RATIO;
  7'd65: static_cc_id=`PARAM_ID_COMP_ATTACK;
  7'd66: static_cc_id=`PARAM_ID_COMP_RELEASE;
  7'd67: static_cc_id=`PARAM_ID_COMP_MAKEUP;
  7'd68: static_cc_id=`PARAM_ID_COMP_MIX;
  7'd69: static_cc_id=`PARAM_ID_VIB_ENABLE;
  7'd70: static_cc_id=`PARAM_ID_VIB_RATE;
  7'd71: static_cc_id=`PARAM_ID_VIB_DEPTH;
  7'd72: static_cc_id=`PARAM_ID_PORTA_ENABLE;
  7'd73: static_cc_id=`PARAM_ID_PORTA_TIME;
  default: static_cc_id=0;
 endcase end
endfunction
