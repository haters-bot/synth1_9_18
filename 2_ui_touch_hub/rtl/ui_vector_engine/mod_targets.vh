function [5:0] mod_target;
    input [13:0] px,py;
    integer k;
    reg [5:0] selected;
    reg any_hit;
    begin selected=0;any_hit=0;
        for(k=0;k<53;k=k+1) begin
            if(px>=mod_cx(k)-22 && px<=mod_cx(k)+22 &&
               py>=mod_cy(k)-22 && py<=mod_cy(k)+22) begin
                selected=selected | k[5:0];any_hit=1;
            end
        end
        mod_target=any_hit ? selected : 6'd63;
    end
endfunction
