function [1:0] get_font_7x10;
    input [5:0] ch;
    input [2:0] rx;
    input [3:0] ry;
    reg [13:0] row_bits;
    begin
        row_bits=get_font_7x10_row(ch,ry);
        case(rx)
            0: get_font_7x10=row_bits[13:12];
            1: get_font_7x10=row_bits[11:10];
            2: get_font_7x10=row_bits[9:8];
            3: get_font_7x10=row_bits[7:6];
            4: get_font_7x10=row_bits[5:4];
            5: get_font_7x10=row_bits[3:2];
            6: get_font_7x10=row_bits[1:0];
            default: get_font_7x10=2'd0;
        endcase
    end
endfunction
// Used only on literal strings: fold ASCII conversion at elaboration.
function [143:0] pack_font24;
    input [191:0] text;
    integer i;
    reg [7:0] c;
    begin
        pack_font24=0;
        for(i=0;i<24;i=i+1) begin
            c=text[191-i*8 -: 8];
            if(c>=65 && c<=90) pack_font24[143-i*6 -: 6]=c-64;
            else if(c>=48 && c<=57) pack_font24[143-i*6 -: 6]=c-21;
            else if(c==45) pack_font24[143-i*6 -: 6]=37;
            else if(c==43) pack_font24[143-i*6 -: 6]=38;
            else if(c==58) pack_font24[143-i*6 -: 6]=39;
            else if(c==46) pack_font24[143-i*6 -: 6]=40;
        end
    end
endfunction
