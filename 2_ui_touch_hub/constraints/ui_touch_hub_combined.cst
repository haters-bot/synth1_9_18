// Physical Constraints: ui_touch_hub.cst
// Target Board: Sipeed Tang Mega 138K Dock (GW5AST-LV138PG484AC1/I0, PBGA484A)
// Bank Voltage: 3.3V LVCMOS
// ==============================================================================

// 50MHz System Clock & Reset
// Keep the three local serializer reset chains in their previously audited
// bottom-right fabric sites. An unconstrained placement spread clk_5x_bit
// across PTR3/PBR3 and failed minimum clock pulse width on these nine FFs.
// Sites are from the 20261019_200320 routed timing report; all recovery,
// removal, setup, hold and pulse-width checks remain enabled.
INS_LOC "u_dvi_tx/gen_enc[0].dvi_tx_tmds_phy_inst/reset_pipe_0_s1" R101C159[0][A];
INS_LOC "u_dvi_tx/gen_enc[0].dvi_tx_tmds_phy_inst/reset_pipe_1_s1" R101C161[0][A];
INS_LOC "u_dvi_tx/gen_enc[0].dvi_tx_tmds_phy_inst/reset_pipe_2_s1" R101C163[0][A];
INS_LOC "u_dvi_tx/gen_enc[1].dvi_tx_tmds_phy_inst/reset_pipe_0_s1" R88C164[0][B];
INS_LOC "u_dvi_tx/gen_enc[1].dvi_tx_tmds_phy_inst/reset_pipe_1_s1" R90C166[0][A];
INS_LOC "u_dvi_tx/gen_enc[1].dvi_tx_tmds_phy_inst/reset_pipe_2_s1" R92C166[0][A];
INS_LOC "u_dvi_tx/gen_enc[2].dvi_tx_tmds_phy_inst/reset_pipe_0_s1" R63C164[0][B];
INS_LOC "u_dvi_tx/gen_enc[2].dvi_tx_tmds_phy_inst/reset_pipe_1_s1" R61C164[0][A];
INS_LOC "u_dvi_tx/gen_enc[2].dvi_tx_tmds_phy_inst/reset_pipe_2_s1" R60C166[0][A];

// Historical navigation anchor, retired after the glyph-row/column pipeline
// split changed the synthesized character register object. Keep the record;
// the new font pipeline is placed normally and must pass the complete audit.
// INS_LOC "u_render/u_navigation_render/ch1_0_s0" R35C151[0][A];

IO_LOC  "clk"             V22;
IO_PORT "clk"             IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC  "rst_n"           AA13;
IO_PORT "rst_n"           IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Status LEDs
IO_LOC  "led[0]"          T18;
IO_PORT "led[0]"          IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "led[1]"          R18;
IO_PORT "led[1]"          IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// HDMI Type-A Differential Video Port (J29)
IO_LOC  "tmds_d_p_0[0]"   J14,H14;
IO_PORT "tmds_d_p_0[0]"   IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "tmds_d_p_0[1]"   J15,H15;
IO_PORT "tmds_d_p_0[1]"   IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "tmds_d_p_0[2]"   K17,J17;
IO_PORT "tmds_d_p_0[2]"   IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

