IO_LOC  "knob_reset_n" D14;
IO_PORT "knob_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Audio-engine UART MIDI output to PMOD1 IO2 (J8 pin 9, 3.3V GPIO).
IO_LOC  "audio_link_tx"   AB21;
IO_PORT "audio_link_tx"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Audio-board I2S visualization return.  The audio board mirrors its
// MAX98357A stream to these three 3.3 V outputs.
IO_LOC  "audio_vis_bclk"   R19;
IO_PORT "audio_vis_bclk"   IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "audio_vis_lrc"    U21;
