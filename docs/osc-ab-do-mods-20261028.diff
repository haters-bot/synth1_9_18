+
+// 8位、2048深度同步单口RAM。仿真使用行为模型，Gowin构建使用SP原语。
+// 两个实例分别承载16位延迟样本的高低字节，保持一个时钟读延迟。
+module audio_delay_ram8 (
+    input  wire       clk,
+    input  wire [13:0] address,
+    input  wire       write_enable,
+    input  wire [7:0] write_data,
+    output wire [7:0] read_data
+);
+`ifdef SIM
+    reg [7:0] memory [0:2047];
+    reg [7:0] read_data_q;
+
+    always @(posedge clk) begin
+        if (write_enable)
+            memory[address[13:3]] <= write_data;
+        else
+            read_data_q <= memory[address[13:3]];
+    end
+
+    assign read_data = read_data_q;
+`else
+    wire [31:0] primitive_do;
+
+    SP #(
+        .READ_MODE (1'b0),
+        .WRITE_MODE(2'b00),
+        .BIT_WIDTH (8),
+        .BLK_SEL   (3'b000)
+    ) u_sp (
+        .DO    (primitive_do),
+        .DI    ({24'd0, write_data}),
+        .BLKSEL(3'b000),
+        .AD    (address),
+        .WRE   (write_enable),
+        .CLK   (clk),
+        .CE    (1'b1),
+        .OCE   (1'b1),
+        .RESET (1'b0)
+    );
+
+    assign read_data = primitive_do[7:0];
+`endif
+endmodule
